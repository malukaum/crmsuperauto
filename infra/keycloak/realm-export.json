{
  "realm": "crm",
  "displayName": "CRM Super Auto",
  "displayNameHtml": "<b>CRM</b> Super Auto",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt-BR",
    "en"
  ],
  "defaultLocale": "pt-BR",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "nao-responda@superauto.local",
    "fromDisplayName": "CRM Super Auto",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "gerencial",
        "description": "Gestão da regional: acesso total, inteligência e configurações"
      },
      {
        "name": "vendedor",
        "description": "Vendedor da regional"
      },
      {
        "name": "atendente",
        "description": "Atendente de pós-venda"
      },
      {
        "name": "cliente",
        "description": "Associado (área do cliente)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "crm-web",
      "name": "CRM Super Auto (web)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "",
      "baseUrl": "",
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:8081/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:8081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:8081/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "frontchannel.logout.session.required": "true"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "audiencia-crm-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "crm-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "cpf",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "cpf",
            "claim.name": "cpf",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "crm-api",
      "name": "CRM Super Auto (API)",
      "description": "Audiência da API. Não faz login; existe para ser referenciado no claim aud.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [],
      "webOrigins": []
    }
  ],
