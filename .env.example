# Copie para .env se quiser mudar algo. Sem .env, o docker-compose usa estes mesmos valores padrão.

# Postgres (um servidor, dois bancos: crm e keycloak)
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_PORT=5432

# Keycloak
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Segredo do client crm-api (conta de serviço usada pelo backend na gestão de usuários). Igual ao do realm-export.json.
KEYCLOAK_ADMIN_CLIENT_SECRET=crm-api-dev-secret

# Mailpit (e-mails do Keycloak, ex.: "esqueci minha senha")
MAILPIT_PORT=8025

# Backend
BACKEND_PORT=8080

# Frontend (nginx)
FRONTEND_PORT=8081
