# Copie para .env se quiser mudar algo. Sem .env, o docker-compose usa estes mesmos valores padrão.

# Postgres (um servidor, dois bancos: crm e keycloak)
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_PORT=5432

# Keycloak
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Mailpit (e-mails do Keycloak, ex.: "esqueci minha senha")
MAILPIT_PORT=8025

# Backend
BACKEND_PORT=8080

# Frontend (nginx)
FRONTEND_PORT=8081
