# Configuração do Lombok para o backend.
config.stopBubbling = true
# Marca o código gerado com @Generated: ferramentas de cobertura e análise o ignoram.
lombok.addLombokGeneratedAnnotation = true
# @Data e @Setter quebram o modelo rico (mudança de estado só por métodos de domínio) e @EqualsAndHashCode/@ToString
# em entidades JPA disparam carga preguiçosa e laços entre associações: proibidos aqui.
lombok.data.flagUsage = error
lombok.setter.flagUsage = error
lombok.equalsAndHashCode.flagUsage = warning
lombok.toString.flagUsage = warning
