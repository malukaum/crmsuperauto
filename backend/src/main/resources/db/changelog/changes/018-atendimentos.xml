<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ATD-04 · Um atendimento tem no máximo uma correção; a cadeia continua corrigindo a correção. -->
    <changeSet id="018-atendimento-correcao-unica" author="crm-superauto">
        <sql><![CDATA[
CREATE UNIQUE INDEX uk_atendimento_corrige ON atendimento (corrige_atendimento_id)
 WHERE corrige_atendimento_id IS NOT NULL;
        ]]></sql>
        <rollback>
            <sql>DROP INDEX uk_atendimento_corrige;</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
