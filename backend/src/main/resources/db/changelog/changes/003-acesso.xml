<?xml version="1.0" encoding="UTF-8"?>
<!-- 2. ACESSO (identidade vem do Keycloak; aqui só a projeção local) -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-usuario" author="crm-superauto">
        <createTable tableName="usuario">
            <column name="id" type="uuid" remarks="Claim &quot;sub&quot; do Keycloak">
                <constraints primaryKey="true" primaryKeyName="pk_usuario" nullable="false"/>
            </column>
            <column name="username" type="varchar(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_usuario_username"/>
            </column>
            <column name="nome" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(254)"/>
            <column name="ativo" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="criado_em" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="atualizado_em" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
