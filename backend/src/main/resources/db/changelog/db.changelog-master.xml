<?xml version="1.0" encoding="UTF-8"?>
<!--
  CRM Super Auto · changelog principal do Liquibase (PostgreSQL 16)

  Convenções do modelo
    tabelas no singular, snake_case, em português
    PK  : id (bigint identity) — exceto usuario (uuid = "sub" do Keycloak)
    FK  : <entidade>_id
    nomes de constraint: pk_, fk_, uk_, ck_, ix_
    datas de evento em timestamptz; datas de calendário em date
    dinheiro em numeric(12,2); nada de float
    colunas de controle: criado_em, atualizado_em, versao (lock otimista JPA)

  Convenções dos changesets
    um arquivo por área do domínio, incluídos na ordem abaixo
    um changeset por tabela (tabela + checks + índices), com rollback explícito
    CHECKs, índices parciais/de expressão e a extensão pg_trgm vão em <sql>,
    porque o Liquibase Community não tem change types para eles
    changesets já aplicados nunca são editados: toda mudança de estrutura (tabela, coluna, índice, CHECK)
    vai num arquivo novo, versionado na sequência (019-..., 020-...)
    visões não alteram a estrutura: cada uma tem um arquivo em changes/visoes/, editado no lugar, com
    runOnChange + validCheckSum ANY; ficam no fim, na ordem das dependências entre elas
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="changes/001-auditoria-acesso.xml" relativeToChangelogFile="true"/>
    <include file="changes/002-referencia.xml" relativeToChangelogFile="true"/>
    <include file="changes/003-acesso.xml" relativeToChangelogFile="true"/>
    <include file="changes/004-cadastro.xml" relativeToChangelogFile="true"/>
    <include file="changes/005-relacionamento.xml" relativeToChangelogFile="true"/>
    <include file="changes/006-comercial.xml" relativeToChangelogFile="true"/>
    <include file="changes/007-importacao.xml" relativeToChangelogFile="true"/>
    <include file="changes/008-auditoria.xml" relativeToChangelogFile="true"/>
    <include file="changes/010-dados-iniciais.xml" relativeToChangelogFile="true"/>
    <include file="changes/011-busca-sem-acento.xml" relativeToChangelogFile="true"/>
    <include file="changes/012-usuario-sistema.xml" relativeToChangelogFile="true"/>
    <include file="changes/013-carteira.xml" relativeToChangelogFile="true"/>
    <include file="changes/015-contato-unicidade-adiavel.xml" relativeToChangelogFile="true"/>

    <include file="changes/016-filas.xml" relativeToChangelogFile="true"/>
    <include file="changes/018-atendimentos.xml" relativeToChangelogFile="true"/>
    <include file="changes/019-fila-pelo-relogio.xml" relativeToChangelogFile="true"/>
    <include file="changes/020-aniversario-uma-por-ano.xml" relativeToChangelogFile="true"/>
    <include file="changes/021-assistente-ia.xml" relativeToChangelogFile="true"/>

    <!-- Visões: uma por arquivo, editadas no lugar (ver convenções acima) -->
    <include file="changes/visoes/vw_ultimo_contato_regua.xml" relativeToChangelogFile="true"/>
    <include file="changes/visoes/vw_carteira.xml" relativeToChangelogFile="true"/>
    <include file="changes/visoes/vw_historico_atendimento.xml" relativeToChangelogFile="true"/>
    <include file="changes/visoes/vw_trabalho_relacionamento.xml" relativeToChangelogFile="true"/>
</databaseChangeLog>
